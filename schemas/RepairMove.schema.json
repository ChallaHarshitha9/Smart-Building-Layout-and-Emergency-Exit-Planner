      "required": [
        "corridor_id",
        "new_width_cells"
      ],
      "title": "WidenCorridor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "discriminator": {
        "mapping": {
          "add_door": "#/$defs/AddDoor",
          "add_exit": "#/$defs/AddExit",
          "move_exit": "#/$defs/MoveExit",
          "move_room": "#/$defs/MoveRoom",
          "reassign_flex_use": "#/$defs/ReassignFlexUse",
          "resize_room": "#/$defs/ResizeRoom",
          "swap_rooms": "#/$defs/SwapRooms",
          "widen_corridor": "#/$defs/WidenCorridor"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/WidenCorridor"
        },
        {
          "$ref": "#/$defs/AddExit"
        },
        {
          "$ref": "#/$defs/MoveExit"
        },
        {
          "$ref": "#/$defs/AddDoor"
        },
        {
          "$ref": "#/$defs/SwapRooms"
        },
        {
          "$ref": "#/$defs/MoveRoom"
        },
        {
          "$ref": "#/$defs/ResizeRoom"
        },
        {
          "$ref": "#/$defs/ReassignFlexUse"
        }
      ],
      "title": "Action"
    },
    "content_hash": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "cost_estimate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostEstimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "finding_ids": {
      "default": [],
      "items": {
        "maxLength": 96,
        "minLength": 1,
        "pattern": "^F_[0-9]+$",
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    },
    "move_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^MV_[0-9]+$",
      "title": "Move Id",
      "type": "string"
    },
    "proposer": {
      "$ref": "#/$defs/Proposer"
    },
    "rationale": {
      "default": "",
      "title": "Rationale",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "move_id",
    "proposer",
    "action"
  ],
  "title": "RepairMove",
  "type": "object"
}
