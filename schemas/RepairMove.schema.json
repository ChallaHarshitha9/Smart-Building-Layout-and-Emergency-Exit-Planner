        "room_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^R_[a-z][a-z0-9_]*_[0-9]+$",
          "title": "Room Id",
          "type": "string"
        },
        "type": {
          "const": "resize_room",
          "default": "resize_room",
