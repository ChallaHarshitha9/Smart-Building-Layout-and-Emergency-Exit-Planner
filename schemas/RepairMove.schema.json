    "SwapRooms": {
      "additionalProperties": false,
      "properties": {
        "room_a": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^R_[a-z][a-z0-9_]*_[0-9]+$",
          "title": "Room A",
          "type": "string"
        },
        "room_b": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^R_[a-z][a-z0-9_]*_[0-9]+$",
          "title": "Room B",
          "type": "string"
        },
        "type": {
          "const": "swap_rooms",
          "default": "swap_rooms",
