          "const": "move_exit",
          "default": "move_exit",
          "title": "Type",
          "type": "string"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "exit_id",
        "x",
        "y"
      ],
      "title": "MoveExit",
      "type": "object"
    },
    "MoveRoom": {
      "additionalProperties": false,
      "properties": {
        "floor": {
          "minimum": 0,
          "title": "Floor",
          "type": "integer"
        },
        "room_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^R_[a-z][a-z0-9_]*_[0-9]+$",
          "title": "Room Id",
          "type": "string"
        },
        "type": {
          "const": "move_room",
          "default": "move_room",
          "title": "Type",
          "type": "string"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
