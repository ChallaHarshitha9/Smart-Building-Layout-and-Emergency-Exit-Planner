{
  "$defs": {
    "AddDoor": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^(R_[a-z][a-z0-9_]*_[0-9]+|C_[0-9]+|E_[0-9]+|S_[0-9]+|L_[0-9]+)$",
          "title": "A",
          "type": "string"
        },
        "b": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^(R_[a-z][a-z0-9_]*_[0-9]+|C_[0-9]+|E_[0-9]+|S_[0-9]+|L_[0-9]+)$",
          "title": "B",
          "type": "string"
        },
        "floor": {
          "minimum": 0,
          "title": "Floor",
          "type": "integer"
        },
        "type": {
          "const": "add_door",
          "default": "add_door",
          "title": "Type",
          "type": "string"
        },
        "width_cells": {
          "minimum": 1,
          "title": "Width Cells",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "floor",
        "a",
        "b",
        "x",
        "y",
        "width_cells"
      ],
      "title": "AddDoor",
      "type": "object"
    },
    "AddExit": {
      "additionalProperties": false,
      "properties": {
        "connects_to": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^(R_[a-z][a-z0-9_]*_[0-9]+|C_[0-9]+|E_[0-9]+|S_[0-9]+|L_[0-9]+)$",
          "title": "Connects To",
          "type": "string"
        },
        "floor": {
          "minimum": 0,
          "title": "Floor",
          "type": "integer"
        },
        "type": {
          "const": "add_exit",
          "default": "add_exit",
          "title": "Type",
          "type": "string"
        },
        "width_cells": {
          "minimum": 1,
          "title": "Width Cells",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "floor",
        "x",
        "y",
        "width_cells",
        "connects_to"
      ],
      "title": "AddExit",
      "type": "object"
    },
    "CostEstimate": {
      "additionalProperties": false,
      "properties": {
        "cost_units": {
          "minimum": 0.0,
          "title": "Cost Units",
          "type": "number"
        },
        "duration_days": {
          "minimum": 0.0,
          "title": "Duration Days",
          "type": "number"
        }
      },
      "required": [
        "cost_units",
        "duration_days"
      ],
      "title": "CostEstimate",
      "type": "object"
    },
    "MoveExit": {
