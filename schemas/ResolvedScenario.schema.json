{
  "$defs": {
    "EventType": {
      "enum": [
        "exit_blocked",
        "lift_out",
        "second_fire",
        "detector_fail",
        "door_stuck"
      ],
      "title": "EventType",
      "type": "string"
    },
    "HazardVariant": {
      "enum": [
        "A",
        "B"
      ],
      "title": "HazardVariant",
      "type": "string"
    },
    "ResolvedEvent": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "time_s": {
          "minimum": 0.0,
          "title": "Time S",
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/EventType"
        }
      },
      "required": [
        "type",
        "time_s",
        "target_id"
      ],
      "title": "ResolvedEvent",
      "type": "object"
    },
    "ResolvedGroup": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^G_[a-z0-9_]+$",
          "title": "Group Id",
          "type": "string"
        },
        "size": {
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "start_node": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^N_[a-z]+_[0-9]+$",
          "title": "Start Node",
          "type": "string"
        },
        "template_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
          "title": "Template Id",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "template_id",
        "size",
        "start_node"
      ],
      "title": "ResolvedGroup",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResolvedEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "graph_hash": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Graph Hash",
      "type": "string"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/ResolvedGroup"
      },
      "minItems": 1,
      "title": "Groups",
      "type": "array"
    },
    "hazard_variant": {
      "$ref": "#/$defs/HazardVariant"
    },
    "horizon_s": {
      "exclusiveMinimum": 0.0,
      "title": "Horizon S",
      "type": "number"
    },
    "ignition_node": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^N_[a-z]+_[0-9]+$",
      "title": "Ignition Node",
      "type": "string"
    },
    "ignition_time_s": {
      "minimum": 0.0,
      "title": "Ignition Time S",
      "type": "number"
    },
    "scenario_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^SC_[A-Za-z0-9_\\-]+$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "sensor_model_ref": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
      "title": "Sensor Model Ref",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "graph_hash",
    "hazard_variant",
    "ignition_node",
    "ignition_time_s",
    "groups",
    "sensor_model_ref",
    "seed",
    "horizon_s"
  ],
  "title": "ResolvedScenario",
  "type": "object"
}
