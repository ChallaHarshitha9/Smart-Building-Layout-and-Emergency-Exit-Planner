{
  "$defs": {
    "MetricScope": {
      "enum": [
        "run",
        "aggregate",
        "layout"
      ],
      "title": "MetricScope",
      "type": "string"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci High"
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Low"
        },
        "metric_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Metric Id",
          "type": "string"
        },
        "n": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric_id",
        "value"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "Split": {
      "enum": [
        "repair",
        "test"
      ],
      "title": "Split",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "layout_geometry_hash": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Layout Geometry Hash",
      "type": "string"
    },
    "method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method"
    },
    "n_scenarios": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "N Scenarios"
    },
    "scenario_id": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^SC_[A-Za-z0-9_\\-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/MetricScope"
    },
    "seed": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "split": {
      "anyOf": [
        {
          "$ref": "#/$defs/Split"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "values": {
      "items": {
        "$ref": "#/$defs/MetricValue"
      },
      "minItems": 1,
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "scope",
    "layout_geometry_hash",
    "values"
  ],
  "title": "MetricSet",
  "type": "object"
}
