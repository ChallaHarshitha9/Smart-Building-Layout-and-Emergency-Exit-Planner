{
  "$defs": {
    "Algorithm": {
      "enum": [
        "dqn",
        "ppo"
      ],
      "title": "Algorithm",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "$ref": "#/$defs/Algorithm"
    },
    "checkpoint_path": {
      "minLength": 1,
      "title": "Checkpoint Path",
      "type": "string"
    },
    "content_hash": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "layout_geometry_hash": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Layout Geometry Hash",
      "type": "string"
    },
    "obs_spec_version": {
      "minLength": 1,
      "title": "Obs Spec Version",
      "type": "string"
    },
    "policy_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "training_seeds": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "minItems": 1,
      "title": "Training Seeds",
      "type": "array"
    },
    "uses_belief": {
      "title": "Uses Belief",
      "type": "boolean"
    }
  },
  "required": [
    "policy_id",
    "algorithm",
    "checkpoint_path",
    "obs_spec_version",
    "layout_geometry_hash",
    "training_seeds",
    "uses_belief"
  ],
  "title": "Policy",
  "type": "object"
}
