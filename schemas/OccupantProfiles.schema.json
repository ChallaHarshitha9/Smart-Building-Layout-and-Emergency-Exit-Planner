{
  "$defs": {
    "Basis": {
      "description": "Where a number comes from. ``assumption`` is allowed but is always reported.",
      "enum": [
        "code",
        "reference",
        "assumption"
      ],
      "title": "Basis",
      "type": "string"
    },
    "BuildingType": {
      "enum": [
        "office",
        "school",
        "hostel",
        "hospital"
      ],
      "title": "BuildingType",
      "type": "string"
    },
    "GroupTemplate": {
      "additionalProperties": false,
      "properties": {
        "can_use_lift": {
          "default": true,
          "title": "Can Use Lift",
          "type": "boolean"
        },
        "can_use_stairs": {
          "default": true,
          "title": "Can Use Stairs",
          "type": "boolean"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "needs_assistance": {
          "default": false,
          "title": "Needs Assistance",
          "type": "boolean"
        },
        "response_delay_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Response Delay S",
          "type": "number"
        },
        "share": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Share",
          "type": "number"
        },
        "speed_mps": {
          "exclusiveMinimum": 0.0,
          "title": "Speed Mps",
          "type": "number"
        },
        "template_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
          "title": "Template Id",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "label",
        "share",
        "speed_mps"
      ],
      "title": "GroupTemplate",
      "type": "object"
    },
    "OccupancyPeriod": {
      "additionalProperties": false,
      "properties": {
        "dispersion": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Dispersion",
          "type": "number"
        },
        "mean_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Fraction",
          "type": "number"
        },
        "name": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "mean_fraction"
      ],
      "title": "OccupancyPeriod",
      "type": "object"
    },
    "OccupantProfile": {
      "additionalProperties": false,
      "properties": {
        "building_type": {
          "$ref": "#/$defs/BuildingType"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/GroupTemplate"
          },
          "minItems": 1,
          "title": "Groups",
          "type": "array"
        },
        "periods": {
          "items": {
            "$ref": "#/$defs/OccupancyPeriod"
          },
          "minItems": 1,
          "title": "Periods",
          "type": "array"
        },
        "profile_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
          "title": "Profile Id",
          "type": "string"
        },
        "sourcing": {
          "$ref": "#/$defs/Sourcing"
        }
      },
      "required": [
        "profile_id",
        "building_type",
        "groups",
        "periods",
        "sourcing"
      ],
      "title": "OccupantProfile",
      "type": "object"
    },
    "Sourcing": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "basis"
      ],
      "title": "Sourcing",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/OccupantProfile"
      },
      "minItems": 1,
      "title": "Profiles",
      "type": "array"
    },
    "profiles_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
      "title": "Profiles Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "profiles_id",
    "profiles"
  ],
  "title": "OccupantProfiles",
  "type": "object"
}
