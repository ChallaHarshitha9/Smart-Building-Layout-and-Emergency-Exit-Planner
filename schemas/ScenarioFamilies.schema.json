{
  "$defs": {
    "EventSpec": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/Selector"
        },
        "time_s": {
          "minimum": 0.0,
          "title": "Time S",
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/EventType"
        }
      },
      "required": [
        "type",
        "time_s",
        "target"
      ],
      "title": "EventSpec",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "exit_blocked",
        "lift_out",
        "second_fire",
        "detector_fail",
        "door_stuck"
      ],
      "title": "EventType",
      "type": "string"
    },
    "GroupSpec": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^G_[a-z0-9_]+$",
          "title": "Group Id",
          "type": "string"
        },
        "placement": {
          "$ref": "#/$defs/Selector"
        },
        "size_override": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Override"
        },
        "template_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
          "title": "Template Id",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "template_id",
        "placement"
      ],
      "title": "GroupSpec",
      "type": "object"
    },
    "HazardVariant": {
      "enum": [
        "A",
        "B"
      ],
      "title": "HazardVariant",
      "type": "string"
    },
    "IgnitionSpec": {
      "additionalProperties": false,
      "properties": {
        "time_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Time S",
          "type": "number"
        },
        "where": {
          "$ref": "#/$defs/Selector"
        }
      },
      "required": [
        "where"
      ],
      "title": "IgnitionSpec",
      "type": "object"
    },
    "ScenarioFamily": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EventSpec"
          },
          "title": "Events",
          "type": "array"
        },
        "family_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
          "title": "Family Id",
          "type": "string"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/GroupSpec"
          },
          "minItems": 1,
          "title": "Groups",
          "type": "array"
        },
        "hazard_variant": {
          "$ref": "#/$defs/HazardVariant",
          "default": "A"
        },
        "horizon_s": {
          "default": 900.0,
          "exclusiveMinimum": 0.0,
          "title": "Horizon S",
          "type": "number"
        },
        "ignition": {
          "$ref": "#/$defs/IgnitionSpec"
        },
        "n_repair": {
          "default": 3,
          "minimum": 0,
          "title": "N Repair",
          "type": "integer"
        },
        "n_test": {
          "default": 30,
          "minimum": 0,
          "title": "N Test",
          "type": "integer"
        },
        "occupancy_period": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupancy Period"
        },
        "sensor_model_ref": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
          "title": "Sensor Model Ref",
          "type": "string"
        }
      },
      "required": [
        "family_id",
        "ignition",
        "groups",
        "sensor_model_ref"
      ],
      "title": "ScenarioFamily",
      "type": "object"
    },
    "Selector": {
      "additionalProperties": false,
      "description": "Layout-agnostic choice of a room, exit, lift or corridor, resolved later per layout.\n\n``random_room_near_exit`` picks, with the scenario seed, one room among the\n``nearest_fraction`` of rooms closest to an exit by graph distance (ties broken by id).\nThe fraction is relative so the meaning does not depend on building size.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/SelectorMode"
        },
        "nearest_fraction": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nearest Fraction"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Selector",
      "type": "object"
    },
    "SelectorMode": {
      "enum": [
        "explicit_id",
        "room_type",
        "random_room",
        "random_room_near_exit",
        "random_exit",
        "random_lift",
        "random_corridor",
        "nearest_exit_to_ignition",
        "distributed_by_load"
      ],
      "title": "SelectorMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "families": {
      "items": {
        "$ref": "#/$defs/ScenarioFamily"
      },
      "minItems": 1,
      "title": "Families",
      "type": "array"
    },
    "families_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
      "title": "Families Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "families_id",
    "families"
  ],
  "title": "ScenarioFamilies",
  "type": "object"
}
