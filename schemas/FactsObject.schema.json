{
  "$defs": {
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^FA_[0-9]+$",
          "title": "Fact Id",
          "type": "string"
        },
        "metric_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Metric Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "fact_id",
        "metric_id",
        "value",
        "text"
      ],
      "title": "Fact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The only input the explainer may see. Every claim must trace to a fact.",
  "properties": {
    "allowed_claims": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Allowed Claims",
      "type": "array"
    },
    "content_hash": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    },
    "facts_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
      "title": "Facts Id",
      "type": "string"
    },
    "layout_geometry_hash": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Layout Geometry Hash",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "facts_id",
    "layout_geometry_hash"
  ],
  "title": "FactsObject",
  "type": "object"
}
