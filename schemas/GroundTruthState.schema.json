{
  "$defs": {
    "HazardState": {
      "enum": [
        "clear",
        "smoky",
        "fire"
      ],
      "title": "HazardState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Simulator-only. Never visible to planners, belief or RL (except the oracle baseline).",
  "properties": {
    "content_hash": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "devices_ok": {
      "default": {},
      "patternProperties": {
        "^DV_(lift|door|detector|equipment|alarm)_[0-9]+$": {
          "type": "boolean"
        }
      },
      "propertyNames": {
        "maxLength": 96,
        "minLength": 1
      },
      "title": "Devices Ok",
      "type": "object"
    },
    "exits_blocked": {
      "default": [],
      "items": {
        "maxLength": 96,
        "minLength": 1,
        "pattern": "^E_[0-9]+$",
        "type": "string"
      },
      "title": "Exits Blocked",
      "type": "array"
    },
    "graph_hash": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Graph Hash",
      "type": "string"
    },
    "hazard": {
      "patternProperties": {
        "^N_[a-z]+_[0-9]+$": {
          "$ref": "#/$defs/HazardState"
        }
      },
      "propertyNames": {
        "maxLength": 96,
        "minLength": 1
      },
      "title": "Hazard",
      "type": "object"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "smoke": {
      "patternProperties": {
        "^N_[a-z]+_[0-9]+$": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "propertyNames": {
        "maxLength": 96,
        "minLength": 1
      },
      "title": "Smoke",
      "type": "object"
    },
    "t_s": {
      "minimum": 0.0,
      "title": "T S",
      "type": "number"
    }
  },
  "required": [
    "graph_hash",
    "t_s",
    "hazard",
    "smoke"
  ],
  "title": "GroundTruthState",
  "type": "object"
}
